# Copy to .env.local and fill in. Never commit .env.local.

# Neon — pooled connection string
DATABASE_URL=

# Session signing, and the pepper for OTP code hashes. 32+ characters.
# Rotating it invalidates every session and every unconsumed OTP code.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Upstash Redis — rate limiting.
# Required in production: the app refuses to start an OTP request
# without it. Optional locally, where limiters fall back to an
# in-process counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Armenian SMS gateway — OTP delivery.
# Only read when NODE_ENV=production; dev prints codes to the console.
# No vendor is selected yet, so the gateway provider still throws.
SMS_API_KEY=
SMS_SENDER=

# Bearer secret for /api/cron/sweep
CRON_SECRET=
