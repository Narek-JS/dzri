# Copy to .env.local and fill in. Never commit .env.local.

# Neon — pooled connection string
DATABASE_URL=

# Session signing, and the pepper for OTP code hashes. 32+ characters.
# Rotating it invalidates every session and every unconsumed OTP code.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Upstash Redis — rate limiting.
# Required in production: the app refuses to start an OTP request
# without it. Optional locally, where limiters fall back to an
# in-process counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Messaggio — OTP delivery (DECISIONS.md: "SMS gateway vendor chosen").
# Only read when NODE_ENV=production; dev prints codes to the console.
# MESSAGGIO_PROJECT_LOGIN: dashboard → Company → Projects → API Settings.
# MESSAGGIO_SENDER_CODE: dashboard → Senders → the sender's "Sender code
# for API".
MESSAGGIO_PROJECT_LOGIN=
MESSAGGIO_SENDER_CODE=

# Bearer secret for /api/cron/sweep, the hourly job that releases lapsed
# reservations and expires stale items. The same value goes in the
# CRON_SECRET repository secret on GitHub, which is what calls it.
# Unset means the endpoint refuses every caller with a 404 — it fails
# shut, so a deploy that forgets this stops sweeping rather than letting
# strangers expire other people's listings.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Item moderation — 'pre' or 'post'. Defaults to 'pre'.
# 'pre':  an admin approves each new item first; new items start
#         'pending_review'. 'post': items publish immediately as 'active'
#         and are reviewed only when reported.
# Read lazily, so flipping this does not require a rebuild. Any value
# other than 'post' is treated as 'pre'.
MODERATION_MODE=pre
