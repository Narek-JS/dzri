# Copy to .env.local and fill in. Never commit .env.local.

# Neon — pooled connection string
DATABASE_URL=

# Session signing. 32+ random bytes.
JWT_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Upstash Redis — rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Armenian SMS gateway — OTP delivery
SMS_API_KEY=
SMS_SENDER=

# Bearer secret for /api/cron/sweep
CRON_SECRET=
